# HuggingFace token required for pyannote speaker diarization
HF_TOKEN=

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default WhisperX settings (tuned for 6 GB VRAM GPUs)
WHISPER_MODEL=base
COMPUTE_TYPE=auto
WHISPER_BATCH_SIZE=8
WHISPER_VAD_METHOD=pyannote

# Maximum upload size in megabytes
MAX_UPLOAD_MB=500

# Optional override for job storage directory
# DUBIT_JOBS_DIR=D:\Dubit\backend\jobs
